# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://pqc_user:pqc_password@localhost:5432/pqc_secure
DATABASE_POOL_SIZE=10
DATABASE_POOL_RECYCLE=3600

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing Configuration
PASSWORD_HASHING_ALGORITHM=argon2id
PASSWORD_MIN_LENGTH=8

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5

# Storage Configuration
STORAGE_TYPE=filesystem
STORAGE_PATH=./data/uploads
STORAGE_BUCKET=pqc-files
MAX_FILE_SIZE_MB=500
MAX_RECIPIENTS_PER_SHARE=10

# MinIO Configuration (when using S3 storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Cryptographic Configuration
DEFAULT_CRYPTO_MODE=pqc
ENABLE_PQC_MODE=true
ENABLE_CLASSICAL_MODE=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Audit Logging Configuration
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_EVENTS=auth,permission,crypto,upload,download

# Session Configuration
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
