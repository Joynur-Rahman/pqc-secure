# Staging Environment Configuration
# Used for staging/pre-production deployments

# API Configuration
# Set to your staging backend API URL
VITE_API_URL=https://staging-api.example.com/api

# HTTPS Configuration
# Staging uses HTTPS
VITE_USE_HTTPS=false

# API Target for Proxy
VITE_API_TARGET=https://staging-api.example.com

# Application Name
VITE_APP_NAME=PQC-Secure (Staging)

# API Timeout (in milliseconds)
VITE_API_TIMEOUT=30000

# Enable Debug Mode (can be true for debugging in staging)
VITE_DEBUG=true
