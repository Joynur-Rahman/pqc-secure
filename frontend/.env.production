# Production Environment Configuration
# Used when building for production (npm run build)

# API Configuration
# Set to your production backend API URL
# Example: https://api.example.com/api or https://example.com/api
VITE_API_URL=https://api.example.com/api

# HTTPS Configuration
# Production always uses HTTPS
VITE_USE_HTTPS=false

# API Target for Proxy
# Not used in production builds, only for development
VITE_API_TARGET=https://api.example.com

# Application Name
VITE_APP_NAME=PQC-Secure

# API Timeout (in milliseconds)
VITE_API_TIMEOUT=30000

# Enable Debug Mode (should be false in production)
VITE_DEBUG=false
