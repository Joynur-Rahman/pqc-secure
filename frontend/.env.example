# Frontend Environment Configuration Example
# Copy this file to .env or .env.local and adjust for your environment

# API Configuration
# Set to the backend API URL that the frontend will communicate with
VITE_API_URL=http://localhost:8000/api

# HTTPS Configuration for Local Development
# Set to 'true' to enable HTTPS, 'false' for HTTP (default: false)
VITE_USE_HTTPS=false

# API Target for Proxy
# The backend server URL for the Vite proxy (used in dev server only)
VITE_API_TARGET=http://localhost:8000

# Application Name (optional)
VITE_APP_NAME=PQC-Secure

# API Timeout (in milliseconds, optional)
VITE_API_TIMEOUT=30000

# Enable Debug Mode (optional)
VITE_DEBUG=false
